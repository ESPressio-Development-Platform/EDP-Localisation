{
  "name": "EDP-Localisation",
  "description": "Deterministic externalised localisation and presentation-string resolution for the ESPressio Development Platform",
  "keywords": "espressio,localisation,localization,embedded,deterministic",
  "homepage": "https://espressio.org",
  "authors": {
    "name": "Simon Stuart",
    "maintainer": true,
    "url": "https://espressio.org"
  },
  "build": {
    "flags": [
      "-std=gnu++20"
    ],
    "unflags": [
      "-std=gnu++11",
      "-std=gnu++14",
      "-std=gnu++17"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ESPressio-Development-Platform/EDP-Localisation.git"
  },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "*",
  "dependencies": [
    {
      "name": "EDP-System",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-System.git#feature/composition_framework_enhancements",
      "platforms": "*"
    },
    {
      "name": "EDP-Memory",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Memory.git#feature/composition_framework_enhancements",
      "platforms": "*"
    }
  ]
}
